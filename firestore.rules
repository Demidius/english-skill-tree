rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function self(uid) { return signed() && request.auth.uid == uid; }
    function admin() { return signed() && exists(/databases/$(database)/documents/accessAdmins/$(request.auth.uid)); }
    function profile(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    function mayRead(uid) {
      return self(uid) || admin() || profile(uid).get('visibility', 'private') == 'public'
        || (signed() && exists(/databases/$(database)/documents/profiles/$(uid)/friends/$(request.auth.uid)));
    }
    function validProfile(v) {
      return v.name is string && v.name.size() >= 1 && v.name.size() <= 30
        && v.visibility in ['private', 'public'];
    }
    match /profiles/{uid} {
      allow get: if mayRead(uid);
      allow list: if admin();
      allow create: if admin() || (self(uid) && validProfile(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'visibility', 'createdAt', 'updatedAt']));
      allow update: if admin() || (self(uid) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'visibility', 'updatedAt']));
      allow delete: if admin();
      match /{kind}/{id} {
        allow read: if kind in ['progress', 'tests', 'cards'] && mayRead(uid);
        allow write: if kind in ['progress', 'tests', 'cards'] && (self(uid) || admin());
      }
      match /friends/{peer} {
        allow get: if self(uid) || self(peer) || admin();
        allow list: if self(uid) || admin();
        // An accepted invitation and both edges must be committed together.
        allow create: if validFriend(uid, peer);
        allow update: if false;
        allow create, update: if admin();
        allow delete: if admin() || ((self(uid) || self(peer))
          && !existsAfter(/databases/$(database)/documents/profiles/$(peer)/friends/$(uid)));
      }
    }
    function validFriend(uid, peer) {
      let v = request.resource.data;
      let before = get(/databases/$(database)/documents/friendInvites/$(v.inviteId)).data;
      let after = getAfter(/databases/$(database)/documents/friendInvites/$(v.inviteId)).data;
      let other = getAfter(/databases/$(database)/documents/profiles/$(peer)/friends/$(uid)).data;
      return signed() && uid != peer && (self(uid) || self(peer))
        && v.keys().hasOnly(['inviteId', 'createdAt']) && v.createdAt == request.time
        && before.status == 'open' && before.expiresAt > request.time
        && after.status == 'accepted' && after.acceptedBy == request.auth.uid
        && ((after.ownerId == uid && after.acceptedBy == peer) || (after.ownerId == peer && after.acceptedBy == uid))
        && other.inviteId == v.inviteId && other.createdAt == request.time;
    }
    match /friendInvites/{token} {
      allow create, update: if admin();
      allow get: if signed() && (admin() || resource.data.ownerId == request.auth.uid
        || resource.data.get('acceptedBy', '') == request.auth.uid
        || (resource.data.status == 'open' && resource.data.expiresAt > request.time));
      allow list: if signed() && (admin() || resource.data.ownerId == request.auth.uid);
      allow create: if signed() && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == profile(request.auth.uid).name
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if signed() && (revokeInvite() || acceptInvite());
      allow delete: if admin();
      function revokeInvite() {
        return self(resource.data.ownerId) && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'revoked';
      }
      function acceptInvite() {
        let owner = resource.data.ownerId;
        let peer = request.auth.uid;
        let a = getAfter(/databases/$(database)/documents/profiles/$(owner)/friends/$(peer)).data;
        let b = getAfter(/databases/$(database)/documents/profiles/$(peer)/friends/$(owner)).data;
        return peer != owner && resource.data.status == 'open' && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == peer
          && request.resource.data.acceptedAt == request.time
          && a.inviteId == token && b.inviteId == token && a.createdAt == request.time && b.createdAt == request.time;
      }
    }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /accessAdmins/{uid} { allow get: if self(uid); allow list: if admin(); allow write: if false; }
    match /system/{id} { allow read: if id == 'access' || admin(); allow write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
