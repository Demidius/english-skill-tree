{
  "name": "english-skill-tree",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:access",
    "test:access": "firebase emulators:exec --only firestore --project demo-skill-tree \"node --test tests/access.test.cjs\"",
    "test:unit": "node --test tests/a1-phrases.test.cjs tests/audit-fixes.test.cjs tests/beginner-course.test.cjs",
    "access:setup": "node scripts/setup-access.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-admin": "13.0.2",
    "firebase-tools": "14.27.0"
  }
}
